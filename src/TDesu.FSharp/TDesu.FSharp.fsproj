<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <RootNamespace>TDesu.FSharp</RootNamespace>
        <Authors>TDesu</Authors>
        <Description>Generic F# utility library: operators, type extensions, computation expressions, string helpers, task/result combinators.</Description>
        <PackageTags>fsharp;utilities;common;computation-expressions;task;result</PackageTags>
        <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/techiedesu/TDesu.FSharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/techiedesu/TDesu.FSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- SourceLink: navigate to F# source from Rider/VS -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Core\Operators.fs" />
        <!-- Ahead of everything that parses: the `Option`/`ValueOption` TryXxx adapters live here, and
             `Char`, `NumericParsing` and `Numerics` all build their `tryParse` on them. This file
             itself only needs `Operators`. -->
        <Compile Include="Core\Options.fs" />
        <Compile Include="Core\Byref.fs" />
        <Compile Include="Core\Guard.fs" />
        <Compile Include="Core\UnixTime.fs" />
        <Compile Include="Core\Char.fs" />
        <Compile Include="Core\Regex.fs" />
        <Compile Include="Core\Clock.fs" />
        <Compile Include="Core\String.fs" />
        <Compile Include="Core\NumericParsing.fs" />
        <Compile Include="Core\Numerics.fs" />
        <Compile Include="Core\Union.fs" />
        <Compile Include="Collections\Dictionary.fs" />
        <Compile Include="Collections\Stack.fs" />
        <Compile Include="Collections\Seq.fs" />
        <Compile Include="Collections\Array.fs" />
        <Compile Include="Collections\Streams.fs" />
        <Compile Include="Collections\List.fs" />
        <Compile Include="Collections\ResizeArray.fs" />
        <Compile Include="Tasks\Task.fs" />
        <Compile Include="Tasks\TaskVOption.fs" />
        <Compile Include="Tasks\TaskOption.fs" />
        <Compile Include="Tasks\TaskResult.fs" />
        <Compile Include="Tasks\TaskGroup.fs" />
        <Compile Include="IO\FileSystem.fs" />
        <Compile Include="IO\Env.fs" />
        <Compile Include="IO\Stream.fs" />
        <Compile Include="IO\Disposable.fs" />
        <Compile Include="Concurrency\CancellationToken.fs" />
        <Compile Include="Concurrency\Atomics.fs" />
        <Compile Include="Concurrency\Signal.fs" />
        <Compile Include="Concurrency\BoundedQueue.fs" />
        <Compile Include="Concurrency\BoundedDict.fs" />
        <Compile Include="Concurrency\PeriodicTimer.fs" />
        <Compile Include="Concurrency\SnapshotThrottle.fs" />
        <Compile Include="Concurrency\ChannelWorker.fs" />
        <Compile Include="Concurrency\RateLimiting.fs" />
        <Compile Include="Core\StateMachine.fs" />
        <Compile Include="Buffers\Buffers.fs" />
        <Compile Include="Buffers\ValueStringBuilder.fs" />
        <Compile Include="ActivePatterns\ActivePatterns.fs" />
        <Compile Include="ActivePatterns\Comparisons.fs" />
        <Compile Include="IO\TemporaryFileStream.fs" />
        <Compile Include="Types\Types.fs" />
        <Compile Include="Core\Validation.fs" />
        <Compile Include="Resilience\Retry.fs" />
        <Compile Include="Resilience\Timeout.fs" />
        <Compile Include="Resilience\CircuitBreaker.fs" />
        <Compile Include="Resilience\Memoize.fs" />
        <Compile Include="Resilience\Saga.fs" />
        <Compile Include="Hashing\Hashing.fs" />
        <Compile Include="Builders\Builders.fs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="System.Threading.Channels" />
        <PackageReference Include="MinVer" PrivateAssets="all" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    </ItemGroup>

</Project>
