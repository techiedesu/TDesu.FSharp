        <Compile Include="Collections\ArrayTests.fs" />
        <Compile Include="Collections\SeqTests.fs" />
        <Compile Include="Tasks\TaskTests.fs" />
        <Compile Include="Tasks\TaskVOptionTests.fs" />
        <Compile Include="Tasks\TaskResultTests.fs" />
        <Compile Include="Tasks\TaskGroupTests.fs" />
        <Compile Include="Tasks\ParallelThrottleTests.fs" />
        <Compile Include="IO\DisposableTests.fs" />
