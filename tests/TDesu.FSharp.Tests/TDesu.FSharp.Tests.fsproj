        <Compile Include="Concurrency\RateLimitingBoundaryTests.fs" />
        <Compile Include="Buffers\BuffersTests.fs" />
        <Compile Include="Buffers\ArrayPoolTests.fs" />
        <Compile Include="Buffers\ValueStringBuilderTests.fs" />
        <Compile Include="ActivePatterns\ComparisonsTests.fs" />
