        <Compile Include="IO\FileSystemTests.fs" />
        <Compile Include="IO\ResourceSafetyTests.fs" />
        <Compile Include="IO\TemporaryFileStreamTests.fs" />
        <Compile Include="Concurrency\ConcurrencyTests.fs" />
        <Compile Include="Concurrency\PeriodicTimerCancellationTests.fs" />
        <Compile Include="Concurrency\CancellationTokenTests.fs" />
